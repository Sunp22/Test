+package com.pixelcite.infiniversepatch;
+
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import net.minecraft.registry.RegistryKey;
+import net.minecraft.util.Identifier;
+import net.minecraft.world.World;
+
+/** Infiniverse levels have no per-world seed; remember the one Fantasy used to carry. */
+public final class WorldSeeds {
+   private static final Map<Identifier, Long> SEEDS = new ConcurrentHashMap<>();
+
+   private WorldSeeds() {
+   }
+
+   public static void put(Identifier id, long seed) {
+      SEEDS.put(id, seed);
+   }
+
+   public static void remove(Identifier id) {
+      SEEDS.remove(id);
+   }
+
+   public static Long get(RegistryKey<World> key) {
+      return SEEDS.get(key.getValue());
+   }
+}
