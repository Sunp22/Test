+   }
+
+   public RuntimeWorldHandle getOrOpenPersistentWorld(Identifier id, RuntimeWorldConfig config) {
+      RegistryKey<World> key = RegistryKey.of(RegistryKeys.WORLD, id);
+      if (this.server.getWorld(key) != null) {
+         return new RuntimeWorldHandle(this.server, key);
+      }
+
+      RegistryEntry<DimensionType> type = config.dimensionTypeEntry;
+      if (type == null && config.dimensionTypeKey != null) {
+         type = this.server.getRegistryManager().get(RegistryKeys.DIMENSION_TYPE).getEntry(config.dimensionTypeKey).orElseThrow();
+      }
+
+      if (type == null || config.generator == null) {
+         throw new IllegalStateException("Cannot open world " + id + ": dimension type / generator not set");
+      }
+
+      DimensionOptions options = new DimensionOptions(type, config.generator);
+      if (config.seed != null) {
+         WorldSeeds.put(id, config.seed);
+      }
+
+      try {
+         ServerWorld w = InfiniverseBridge.getOrCreateWorld(this.server, key, () -> options);
+         if (w == null) {
+            throw new IllegalStateException("Infiniverse returned no world for " + id);
+         }
+      } catch (RuntimeException e) {
+         WorldSeeds.remove(id);
+         throw e;
+      }
+
+      return new RuntimeWorldHandle(this.server, key);
+   }
+}
