diff --git a/.github/workflows/infiniverse-patch.yml b/.github/workflows/infiniverse-patch.yml
new file mode 100644
index 0000000..965aea2
--- /dev/null
+++ b/.github/workflows/infiniverse-patch.yml
@@ -0,0 +1,36 @@
+name: Infiniverse patch
+
+on:
+  push:
+    branches: [ main, master ]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  patch:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: 21
+
+      - uses: gradle/actions/setup-gradle@v4
+        with:
+          gradle-version: 8.10.2
+
+      - name: Build Fantasy->Infiniverse shim
+        run: gradle -p patcher build --no-daemon --stacktrace
+
+      - name: Patch original Turn Battle jar
+        run: python3 patcher/scripts/merge.py --patcher-jar "patcher/build/libs/turnbattle-infiniverse-patch-*.jar" --out dist
+
+      - uses: actions/upload-artifact@v4
+        with:
+          name: turnbattle-infiniverse
+          path: dist/*.jar
+          if-no-files-found: error
diff --git a/patcher/build.gradle b/patcher/build.gradle
new file mode 100644
index 0000000..552b8dc
--- /dev/null
+++ b/patcher/build.gradle
@@ -0,0 +1,25 @@
+plugins {
+    id 'fabric-loom' version '1.9-SNAPSHOT'
+}
+
+version = project.mod_version
+base { archivesName = project.archives_base_name }
+
+repositories { mavenCentral() }
+
+dependencies {
+    minecraft "com.mojang:minecraft:${project.minecraft_version}"
+    mappings "net.fabricmc:yarn:${project.yarn_mappings}:v2"
+    modImplementation "net.fabricmc:fabric-loader:${project.loader_version}"
+    modImplementation "net.fabricmc.fabric-api:fabric-api:${project.fabric_version}"
+}
+
+processResources {
+    inputs.property 'version', project.version
+    filesMatching('fabric.mod.json') { expand 'version': project.version }
+}
+
+tasks.withType(JavaCompile).configureEach {
+    it.options.encoding = 'UTF-8'
+    it.options.release = 21
+}
diff --git a/patcher/gradle.properties b/patcher/gradle.properties
new file mode 100644
index 0000000..5efd80f
--- /dev/null
+++ b/patcher/gradle.properties
@@ -0,0 +1,7 @@
+org.gradle.jvmargs=-Xmx2G
+minecraft_version=1.21.1
+yarn_mappings=1.21.1+build.3
+loader_version=0.16.10
+fabric_version=0.115.0+1.21.1
+mod_version=1.0.0
+archives_base_name=turnbattle-infiniverse-patch
