@@ -0,0 +1,35 @@
+package xyz.nucleoid.fantasy;
+
+import com.pixelcite.infiniversepatch.InfiniverseBridge;
+import com.pixelcite.infiniversepatch.PatchInit;
+import net.minecraft.registry.RegistryKey;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.world.ServerWorld;
+import net.minecraft.world.World;
+
+public class RuntimeWorldHandle {
+   private final MinecraftServer server;
+   private final RegistryKey<World> key;
+
+   RuntimeWorldHandle(MinecraftServer server, RegistryKey<World> key) {
+      this.server = server;
+      this.key = key;
+   }
+
+   public ServerWorld asWorld() {
+      return this.server.getWorld(this.key);
+   }
+
+   public RegistryKey<World> getRegistryKey() {
+      return this.key;
+   }
+
+   public void unload() {
+      InfiniverseBridge.unregisterWorld(this.server, this.key);
+   }
+
+   public void delete() {
+      PatchInit.scheduleDelete(this.key);
+      InfiniverseBridge.unregisterWorld(this.server, this.key);
+   }
+}
