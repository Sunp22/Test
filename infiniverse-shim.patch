diff --git a/patcher/scripts/merge.py b/patcher/scripts/merge.py
new file mode 100755
index 0000000..206c070
--- /dev/null
+++ b/patcher/scripts/merge.py
@@ -0,0 +1,190 @@
+#!/usr/bin/env python3
+"""Overlay the Fantasy->Infiniverse shim onto the ORIGINAL Turn Battle jar (no decompiled source involved)."""
+import argparse, glob, json, os, re, shutil, subprocess, sys, tempfile, zipfile
+
+ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
+SKIP_DIRS = {".git", "patcher", "src", "build", ".gradle", ".github", "node_modules"}
+FANTASY = "xyz/nucleoid/fantasy/"
+MIXIN_CFG = "turnbattle-infiniverse.mixins.json"
+ENTRYPOINT = "com.pixelcite.infiniversepatch.PatchInit"
+
+
+def mod_id(path):
+    try:
+        with zipfile.ZipFile(path) as z:
+            return json.loads(z.read("fabric.mod.json").decode("utf-8-sig")).get("id")
+    except Exception:
+        return None
+
+
+def find_original(explicit):
+    if explicit:
+        return explicit
+    found = []
+    for d, dirs, files in os.walk(ROOT):
+        dirs[:] = [x for x in dirs if x not in SKIP_DIRS]
+        for f in files:
+            p = os.path.join(d, f)
+            if zipfile.is_zipfile(p) and mod_id(p) == "turnbattle":
+                found.append(p)
+    if not found:
+        sys.exit("ERROR: no Fabric jar with mod id 'turnbattle' found in the repo (pass --original PATH).")
+    found.sort(key=os.path.getsize, reverse=True)
+    print("Original jar:", found[0], "(candidates: %d)" % len(found))
+    return found[0]
+
+
+def javap(args):
+    return subprocess.run(["javap"] + args, capture_output=True, text=True, check=True).stdout
+
+
+def audit(orig_dir, shim_dir):
+    """Every Fantasy member the original calls must exist in the shim (same name + descriptor)."""
+    needle = FANTASY.encode()
+    users = []
+    for d, _, files in os.walk(orig_dir):
+        for f in files:
+            p = os.path.join(d, f)
+            rel = os.path.relpath(p, orig_dir).replace(os.sep, "/")
+            if f.endswith(".class") and not rel.startswith(FANTASY):
+                with open(p, "rb") as fh:
+                    if needle in fh.read():
+                        users.append(p)
+    print("Classes referencing Fantasy: %d" % len(users))
+    for u in users:
+        print("  ", os.path.relpath(u, orig_dir))
+    if not users:
+        return
+
+    used = set()
+    pat = re.compile(r"(?:Method|InterfaceMethod|Field)\s+(xyz/nucleoid/fantasy/[\w/$]+)\.([\w<>$]+)(?::|\s+)\s*(\S*)")
+    out = javap(["-c", "-p"] + users)
+    for line in out.splitlines():
+        m = re.search(r"(Method|InterfaceMethod|Field)\s+(xyz/nucleoid/fantasy/[\w/$]+)\.([\w<>$]+):(\S+)", line)
+        if m:
+            used.add((m.group(1), m.group(2), m.group(3), m.group(4)))
+
+    have = set()
+    shim_classes = []
+    for d, _, files in os.walk(os.path.join(shim_dir, "xyz", "nucleoid", "fantasy")):
+        shim_classes += [os.path.join(d, f) for f in files if f.endswith(".class")]
+    cur = None
+    for line in javap(["-p", "-s", "-cp", shim_dir] + shim_classes).splitlines():
+        cm = re.match(r"^(?:public |final |abstract )*(?:class|interface) ([\w.$]+)", line)
+        if cm:
+            cur = cm.group(1).replace(".", "/")
+            continue
+        sm = re.match(r"^\s+(?:[\w.<>\[\], $?]+ )?(<init>|[\w$]+|[\w.$]+)\(.*\);?$", line)
+        if sm and cur:
+            name = sm.group(1)
+            if "." in name:
+                name = "<init>"
+            pending = name
+            continue
+        dm = re.match(r"^\s+descriptor: (\S+)", line)
+        if dm and cur:
+            have.add((cur, pending, dm.group(1)))
+        fm = re.match(r"^\s+(?:[\w.<>\[\], $?]+ )?([\w$]+);$", line)
+        if fm and cur:
+            pending = fm.group(1)
+
+    missing = []
+    for kind, cls, name, desc in sorted(used):
+        if kind == "Field":
+            continue
+        if (cls, name, desc) not in have:
+            missing.append("%s.%s:%s" % (cls, name, desc))
+    if missing:
+        print("\nWARNING: the original jar may call Fantasy API the shim does not provide (audit is advisory):")
+        for m in missing:
+            print("   ", m)
+        print("If any of these are real, add them to patcher/src/main/java/xyz/nucleoid/fantasy/ and rebuild.")
+        return
+    print("Audit OK: all %d Fantasy calls are covered by the shim." % len(used))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--original")
+    ap.add_argument("--patcher-jar")
+    ap.add_argument("--out", default="dist")
+    a = ap.parse_args()
+
+    original = find_original(a.original)
+    pj = a.patcher_jar or sorted(glob.glob(os.path.join(ROOT, "patcher", "build", "libs", "*.jar")))[-1]
+    pj = [p for p in glob.glob(pj)][0] if "*" in pj else pj
+    work = tempfile.mkdtemp()
+    orig_dir, shim_dir = os.path.join(work, "orig"), os.path.join(work, "shim")
+    zipfile.ZipFile(original).extractall(orig_dir)
+    zipfile.ZipFile(pj).extractall(shim_dir)
+
+    audit_dir = orig_dir
+    # remove any embedded Fantasy (jar-in-jar or shaded)
+    jars_dir = os.path.join(orig_dir, "META-INF", "jars")
+    removed_jars = []
+    if os.path.isdir(jars_dir):
+        for f in os.listdir(jars_dir):
+            if "fantasy" in f.lower():
+                os.remove(os.path.join(jars_dir, f))
+                removed_jars.append("META-INF/jars/" + f)
+    shutil.rmtree(os.path.join(orig_dir, "xyz", "nucleoid", "fantasy"), ignore_errors=True)
+
+    # fabric.mod.json
+    fp = os.path.join(orig_dir, "fabric.mod.json")
+    with open(fp, encoding="utf-8-sig") as fh:
+        fmj = json.load(fh)
+    for section in ("depends", "recommends", "suggests", "breaks", "conflicts"):
+        if isinstance(fmj.get(section), dict):
+            fmj[section].pop("fantasy", None)
+    if isinstance(fmj.get("jars"), list):
+        fmj["jars"] = [j for j in fmj["jars"] if "fantasy" not in json.dumps(j).lower()]
+        if not fmj["jars"]:
+            del fmj["jars"]
+    mixins = fmj.setdefault("mixins", [])
+    if not isinstance(mixins, list):
+        mixins = fmj["mixins"] = [mixins]
+    if MIXIN_CFG not in mixins:
+        mixins.append(MIXIN_CFG)
+    mains = fmj.setdefault("entrypoints", {}).setdefault("main", [])
+    if ENTRYPOINT not in mains:
+        mains.append(ENTRYPOINT)
+    with open(fp, "w", encoding="utf-8") as fh:
+        json.dump(fmj, fh, indent=2)
+
+    # overlay shim (everything but its own fabric.mod.json / META-INF)
+    for d, _, files in os.walk(shim_dir):
+        for f in files:
+            src = os.path.join(d, f)
+            rel = os.path.relpath(src, shim_dir)
+            if rel == "fabric.mod.json" or rel.startswith("META-INF"):
+                continue
+            dst = os.path.join(orig_dir, rel)
+            os.makedirs(os.path.dirname(dst), exist_ok=True)
+            shutil.copy2(src, dst)
+
+    # audit against the ORIGINAL classes (re-extract, since we may have deleted embedded ones)
+    pristine = os.path.join(work, "pristine")
+    zipfile.ZipFile(original).extractall(pristine)
+    audit(pristine, shim_dir)
+
+    os.makedirs(a.out, exist_ok=True)
+    out = os.path.join(a.out, os.path.basename(original).rsplit(".", 1)[0] + "-infiniverse.jar")
+    if os.path.exists(out):
+        os.remove(out)
+    with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
+        mf = os.path.join(orig_dir, "META-INF", "MANIFEST.MF")
+        if os.path.exists(mf):
+            z.write(mf, "META-INF/MANIFEST.MF")
+        for d, _, files in os.walk(orig_dir):
+            for f in sorted(files):
+                p = os.path.join(d, f)
+                rel = os.path.relpath(p, orig_dir).replace(os.sep, "/")
+                if rel == "META-INF/MANIFEST.MF" or re.match(r"META-INF/[^/]+\.(SF|RSA|DSA|EC)$", rel):
+                    continue
+                z.write(p, rel)
+    print("Removed embedded Fantasy:", removed_jars or "none found")
+    print("Wrote", out)
+
+
+if __name__ == "__main__":
+    main()
